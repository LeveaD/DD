# DisputeDefend AI — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.

# ---------------------------------------------------------------------------
# Groq API credentials — required for the bounded LLM drafting layer
# ---------------------------------------------------------------------------
# Obtain your API key from: https://console.groq.com/
GROQ_API_KEY=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

# ---------------------------------------------------------------------------
# Groq model selection
# Default (if unset): openai/gpt-oss-20b
# Override to use any Groq-hosted model supporting strict JSON schema structured outputs.
# ---------------------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# LLM generation parameters
# ---------------------------------------------------------------------------
# Temperature: 0.0 = fully deterministic, 1.0 = most creative.
# Keep low for factual dispute drafts.
GROQ_TEMPERATURE=0.1

# Request timeout in milliseconds (default: 30000 = 30 seconds)
GROQ_TIMEOUT_MS=30000
